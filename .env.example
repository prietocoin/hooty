# ============================================================
# Hooty v2 — ejemplo de entorno. No contiene secretos reales.
# ============================================================

# --- HTTP ---
HOOTY_ADDR=:8080
HOOTY_WEBHOOK_TOKEN=
HOOTY_DEFAULT_INSTANCE=Glauk
HOOTY_MAX_BODY_BYTES=26214400
HOOTY_MAX_IMAGE_BYTES=20971520
HOOTY_PROCESSING_TIMEOUT=2m
HOOTY_SHUTDOWN_TIMEOUT=15s
HOOTY_LOG_LEVEL=info
HOOTY_LOG_FORMAT=text

# --- PostgreSQL ---
DATABASE_URL=postgres://usuario:clave@localhost:5432/glauk?sslmode=disable
HOOTY_DB_MAX_CONNS=10

# --- Evolution ---
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=Glauk
EVOLUTION_TIMEOUT=30s
# chat_id del grupo de WhatsApp usado cuando is_prueba=true
EVOLUTION_TEST_GROUP=

# --- Gemini ---
# GEMINI_KEYS acepta varias claves separadas por coma y tiene prioridad.
GEMINI_API_KEY=
GEMINI_KEYS=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT=45s

# --- Cloudflare R2 (S3 compatible) ---
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=remesas-img
R2_PUBLIC_DOMAIN=
R2_REGION=auto
R2_TIMEOUT=60s

# --- Sweeper de impactos ---
HOOTY_SWEEPER_ENABLED=true
HOOTY_SWEEPER_INTERVAL=1h
HOOTY_PROCESSED_RETENTION=1h
HOOTY_ORPHAN_RETENTION=24h
